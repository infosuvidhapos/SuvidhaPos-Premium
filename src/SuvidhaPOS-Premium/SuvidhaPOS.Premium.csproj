<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SuvidhaPOS.Premium</RootNamespace>
    <ApplicationIcon>suvidha-pos.ico</ApplicationIcon>
    <Version>6.12.0</Version>
    <AssemblyVersion>6.12.0.0</AssemblyVersion>
    <FileVersion>6.12.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="NPOI" Version="2.7.3" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.*" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Database\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="suvidha-pos.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>