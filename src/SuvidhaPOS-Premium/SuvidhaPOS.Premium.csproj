<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SuvidhaPOS.Premium</RootNamespace>
    <ApplicationIcon>suvidha-pos.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Database\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="suvidha-pos.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
